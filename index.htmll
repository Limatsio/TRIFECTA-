<div class="fixed bottom-6 right-6 z-50 flex flex-col items-end gap-3">
  <a href="https://www.ubereats.com" target="_blank" rel="noopener" aria-label="Pedir en UberEats"
     class="group flex items-center gap-0 bg-cacao hover:bg-guindadeep text-cream rounded-full shadow-xl shadow-cacao/30 transition-all overflow-hidden">
