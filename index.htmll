<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vitto Café — Diario de Sabores · Providencia</title>
<meta name="description" content="Vitto Café, Miguel Claro 1047, Providencia. Una edición viva de nuestro menú: masa madre, almuerzos de autor y repostería de la tarde.">
<meta name="theme-color" content="#8B1E3F">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E☕%3C/text%3E%3C/svg%3E">

<meta property="og:type" content="restaurant.menu">
<meta property="og:title" content="Vitto Café — Diario de Sabores · Providencia">
<meta property="og:description" content="Café de especialidad, masa madre y cocina de casa en Miguel Claro 1047, Providencia.">
<meta property="og:image" content="https://images.unsplash.com/photo-1521017432531-fbd92d768814?q=80&w=1200&auto=format&fit=crop">

<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,500;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<script>
  tailwind.config = {
    theme: {
      extend: {
        colors: {
          cream: '#FFF9F8',
          ivory: '#FFFDFB',
          blush: '#F8D3DA',
          rose: '#F3A8B5',
          guinda: '#8B1E3F',
          guindadeep: '#5E1329',
          cacao: '#3A2A28',
        },
        fontFamily: {
          display: ['"Playfair Display"', 'serif'],
          body: ['"Plus Jakarta Sans"', 'sans-serif'],
        },
      }
    }
  }
</script>

<style>
  :root{
    --panel-a: #FFF9F8;
    --panel-b: #F8D3DA;
  }
  html{ scroll-behavior:smooth; }
  body{
    font-family:'Plus Jakarta Sans', sans-serif;
    background:#FFF9F8;
    color:#3A2A28;
  }
  h1,h2,h3,.font-display{ font-family:'Playfair Display', serif; }

  @media (prefers-reduced-motion: reduce){
    html{ scroll-behavior:auto; }
    *{ transition-duration:.01ms !important; animation-duration:.01ms !important; }
  }

  /* ---------- Left living cover panel ---------- */
  .left-panel{
    background: radial-gradient(120% 120% at 15% 0%, var(--panel-b) 0%, var(--panel-a) 55%);
    transition: background 1.1s ease;
  }
  body[data-chapter="2"] .left-panel{ --panel-a:#FFF3EF; --panel-b:#F3A8B5; }
  body[data-chapter="3"] .left-panel{ --panel-a:#FCEFEF; --panel-b:#E9A9BC; }

  /* blob organic masks */
  .blob-a{ border-radius: 63% 37% 54% 46% / 55% 45% 60% 40%; }
  .blob-b{ border-radius: 42% 58% 63% 37% / 41% 53% 47% 59%; }
  .blob-c{ border-radius: 55% 45% 38% 62% / 63% 40% 60% 37%; }
  .blob-d{ border-radius: 38% 62% 55% 45% / 45% 38% 62% 55%; }
  .video-blob{ border-radius: 58% 42% 61% 39% / 47% 57% 43% 53%; }

  /* ghost chapter numerals */
  .ghost-num{
    font-family:'Playfair Display', serif;
    font-weight:800;
    color:#8B1E3F;
    opacity:.07;
    line-height:.8;
    user-select:none;
    pointer-events:none;
  }

  /* editorial index leader lines */
  .leader{
    border-bottom: 1.5px dotted rgba(58,42,40,.35);
    flex:1;
    margin:0 .75rem;
    transform: translateY(-4px);
  }

  /* dish hover focus */
  .dish{ transition: opacity .5s ease, filter .5s ease; }
  .dish.dimmed{ opacity:.32; filter: blur(.5px); }

  /* floating ingredient tag */
  .tag-float{
    backdrop-filter: blur(6px);
    background: rgba(255,249,248,.82);
    box-shadow: 0 8px 20px -10px rgba(58,42,40,.35);
  }

  /* pull quote mark */
  .quote-mark{
    font-family:'Playfair Display', serif;
    font-weight:800;
    line-height:.7;
  }

  .fade-up{ opacity:0; transform: translateY(28px); transition: opacity .8s ease, transform .8s ease; }
  .fade-up.in{ opacity:1; transform: translateY(0); }

  ::selection{ background:#F3A8B5; color:#3A2A28; }

  :focus-visible{
    outline: 2px solid #8B1E3F;
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* hero load-in, once, on first paint */
  @keyframes heroIn{
    from{ opacity:0; transform: translateY(14px); }
    to{ opacity:1; transform: translateY(0); }
  }
  .hero-in{ animation: heroIn .9s cubic-bezier(.2,.7,.2,1) both; }
  .hero-in.delay-1{ animation-delay:.08s; }
  .hero-in.delay-2{ animation-delay:.18s; }
  .hero-in.delay-3{ animation-delay:.28s; }
  @media (prefers-reduced-motion: reduce){
    .hero-in{ animation: none; }
  }

  /* slow ambient drift for the still image replacing the ambience video */
  @keyframes ambientDrift{
    0%{ transform: scale(1.04) translate(0,0); }
    100%{ transform: scale(1.12) translate(-1.5%, -1.5%); }
  }
  .ambient-photo{
    animation: ambientDrift 18s ease-in-out infinite alternate;
  }
  @media (prefers-reduced-motion: reduce){
    .ambient-photo{ animation: none; }
  }

  /* scrollbar accent (progressive enhancement) */
  ::-webkit-scrollbar{ width:10px; }
  ::-webkit-scrollbar-track{ background:#FFF9F8; }
  ::-webkit-scrollbar-thumb{ background:#F3A8B5; border-radius:10px; }

  .ambience-btn.active{
    background:#8B1E3F;
    color:#FFF9F8;
  }

  /* dietary tags, tuned to the editorial palette instead of stock Tailwind greens/ambers */
  .tag-veggie{ background:#E8EFD9; color:#4F6B2E; }
  .tag-gf{ background:#F3E6D0; color:#8A5A22; }
  .tag-signature{ background:#F8D3DA; color:#8B1E3F; }

  /* ---------- Accordion (Carta Completa) ---------- */
  .accordion-panel{
    max-height:0;
    overflow:hidden;
    transition:max-height .5s ease;
  }
  .accordion-toggle svg{ transition: transform .3s ease; }
  .accordion-toggle.open svg{ transform: rotate(180deg); }
  .accordion-toggle.open{ background:#8B1E3F; border-color:#8B1E3F; }
  .accordion-toggle.open span{ color:#FFF9F8; }

  /* ---------- UberEats high-contrast accents ---------- */
  .ubereats-banner{
    background: linear-gradient(135deg, #06C167 0%, #05A85B 100%);
  }
  .ubereats-strip{
    background: repeating-linear-gradient(135deg, #8B1E3F, #8B1E3F 22px, #5E1329 22px, #5E1329 44px);
  }
</style>
</head>

<body data-chapter="1" class="antialiased">

<div class="lg:grid lg:grid-cols-2">

  <!-- ============================================================ -->
  <!-- LEFT — LIVING COVER (sticky on desktop)                       -->
  <!-- ============================================================ -->
  <aside class="left-panel lg:sticky lg:top-0 lg:h-screen flex flex-col justify-between px-6 sm:px-10 lg:px-14 py-10 lg:py-12 border-b lg:border-b-0 lg:border-r border-blush/70 relative overflow-hidden">

    <!-- top: eyebrow + rating credential -->
    <div class="hero-in relative z-10 flex items-center justify-between text-[11px] font-semibold tracking-[0.18em] uppercase text-cacao/60">
      <span>Ficha viva · Providencia</span>
      <span class="flex items-center gap-1 text-guinda">★ 4.8 <span class="text-cacao/50 font-medium normal-case tracking-normal">· +100 reseñas</span></span>
    </div>

    <!-- masthead -->
    <div class="hero-in delay-1 relative z-10 mt-8 lg:mt-10">
      <h1 class="font-display text-[clamp(2.75rem,11vw,4.2rem)] leading-[0.92] font-semibold text-cacao">
        Vitto<br><span class="italic text-guinda">Café</span> ♥
      </h1>
      <p class="mt-4 text-cacao/60 text-sm sm:text-base max-w-xs leading-relaxed">
        Un diario de sabores servido a diario en Miguel Claro 1047. Café de especialidad, masa madre y cocina de casa.
      </p>
    </div>

    <!-- live status -->
    <div class="hero-in delay-2 relative z-10 mt-8 flex items-center gap-3 text-sm">
      <span id="statusDot" class="w-2.5 h-2.5 rounded-full bg-emerald-500 shadow-[0_0_0_4px_rgba(16,185,129,0.18)]"></span>
      <span id="statusText" class="font-semibold text-cacao">Calculando horario…</span>
    </div>

    <!-- UberEats — banner de alto contraste -->
    <a href="https://www.ubereats.com" target="_blank" rel="noopener"
       class="ubereats-banner relative z-10 mt-6 flex items-center justify-between gap-3 rounded-2xl px-5 py-4 shadow-xl shadow-emerald-900/20 hover:brightness-105 transition-all group">
      <div>
        <p class="text-white/80 text-[11px] font-semibold uppercase tracking-wide">Delivery a domicilio</p>
        <p class="text-white font-display text-lg font-semibold leading-tight">Pide a Domicilio<br>por UberEats</p>
      </div>
      <span class="w-11 h-11 shrink-0 rounded-full bg-white/20 flex items-center justify-center group-hover:translate-x-1 transition-transform">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </span>
    </a>

    <!-- ambience photo, organic mask (swap the <img> for a <video autoplay muted loop playsinline> once real footage from @vitto.cafee is on hand) -->
    <div class="hero-in delay-3 relative z-10 mt-8">
      <div class="video-blob overflow-hidden w-full max-w-[280px] aspect-[3/4] mx-auto lg:mx-0 shadow-2xl shadow-guinda/20 relative">
        <img class="ambient-photo w-full h-full object-cover"
             src="https://images.unsplash.com/photo-1521017432531-fbd92d768814?q=80&w=800&auto=format&fit=crop"
             alt="Interior acogedor de Vitto Café con luz natural">
        <div class="absolute inset-0 bg-gradient-to-t from-cacao/25 via-transparent to-transparent"></div>
        <div class="absolute bottom-4 left-0 right-0 text-center">
          <span class="tag-float inline-block text-[11px] font-semibold text-cacao px-3 py-1.5 rounded-full">@vitto.cafee</span>
        </div>
      </div>
    </div>

    <!-- ambience selector -->
    <div class="relative z-10 mt-9">
      <p class="font-display italic text-guinda text-sm mb-3">Elige tu momento</p>
      <div class="flex gap-2" id="ambienceSelector">
        <button data-chapter="1" class="ambience-btn active flex-1 text-xs sm:text-sm font-semibold px-3 py-2.5 rounded-full border border-guinda/30 bg-white/70 text-cacao transition-colors">I · Mañana</button>
        <button data-chapter="2" class="ambience-btn flex-1 text-xs sm:text-sm font-semibold px-3 py-2.5 rounded-full border border-guinda/30 bg-white/70 text-cacao transition-colors">II · Tarde</button>
        <button data-chapter="3" class="ambience-btn flex-1 text-xs sm:text-sm font-semibold px-3 py-2.5 rounded-full border border-guinda/30 bg-white/70 text-cacao transition-colors">III · Té</button>
      </div>
      <p class="mt-3 text-xs text-cacao/50">Explorando ahora — <span id="chapterCaption" class="font-semibold text-cacao/80">La Mañana &amp; La Masa Madre</span></p>
    </div>

  </aside>

  <!-- ============================================================ -->
  <!-- RIGHT — SCROLLABLE EDITORIAL GALLERY                          -->
  <!-- ============================================================ -->
  <main class="relative">

    <!-- masthead strip -->
    <div class="px-6 sm:px-10 lg:px-16 pt-14 pb-8 border-b border-blush/60">
      <p class="text-[11px] font-semibold tracking-[0.2em] uppercase text-cacao/45 mb-6">Edición N.º 01 — Verano 2026</p>
      <h2 class="font-display text-3xl sm:text-4xl font-semibold text-cacao mb-8">Índice de la edición</h2>
      <nav class="space-y-3 text-sm sm:text-base">
        <a href="#chapter-1" class="flex items-center text-cacao/75 hover:text-guinda transition-colors">
          <span class="font-display italic text-guinda mr-2">I.</span> La Mañana &amp; La Masa Madre <span class="leader"></span> <span class="text-cacao/40">01</span>
        </a>
        <a href="#chapter-2" class="flex items-center text-cacao/75 hover:text-guinda transition-colors">
          <span class="font-display italic text-guinda mr-2">II.</span> Almuerzos de Autor &amp; Casa <span class="leader"></span> <span class="text-cacao/40">02</span>
        </a>
        <a href="#chapter-3" class="flex items-center text-cacao/75 hover:text-guinda transition-colors">
          <span class="font-display italic text-guinda mr-2">III.</span> Tardes Dulces &amp; Repostería <span class="leader"></span> <span class="text-cacao/40">03</span>
        </a>
        <a href="#resenas" class="flex items-center text-cacao/75 hover:text-guinda transition-colors">
          <span class="font-display italic text-guinda mr-2">IV.</span> Comunidad &amp; Experiencias <span class="leader"></span> <span class="text-cacao/40">04</span>
        </a>
        <a href="#colofon" class="flex items-center text-cacao/75 hover:text-guinda transition-colors">
          <span class="font-display italic text-guinda mr-2">V.</span> Dónde encontrarnos <span class="leader"></span> <span class="text-cacao/40">05</span>
        </a>
      </nav>
    </div>

    <!-- ======================= CHAPTER I ======================= -->
    <section id="chapter-1" data-chapter-section="1" class="relative px-6 sm:px-10 lg:px-16 pt-16 pb-10">
      <span class="ghost-num absolute -top-4 -left-2 sm:left-0 text-[9rem] sm:text-[12rem]">I</span>
      <div class="relative">
        <p class="font-display italic text-guinda text-lg mb-2">Capítulo I</p>
        <h2 class="font-display text-3xl sm:text-4xl font-semibold text-cacao mb-4">La Mañana &amp; La Masa Madre</h2>
        <p class="text-cacao/60 max-w-xl leading-relaxed mb-14">Cada jornada empieza igual: masa fermentada por 24 horas, café recién molido y la luz entrando por Miguel Claro. Esta es la carta con la que despertamos.</p>
      </div>

      <div class="chapter-dishes space-y-20">

        <!-- Dish 01 — feature -->
        <article data-id="d1" class="dish grid sm:grid-cols-[0.9fr_1.1fr] gap-8 items-center">
          <div class="relative blob-a overflow-hidden aspect-[4/5] shadow-xl shadow-guinda/10">
            <img src="https://images.unsplash.com/photo-1533089860892-a7c6f0a88666?q=80&w=800&auto=format&fit=crop" alt="Desayuno Vittorio con masa madre, huevos y palta" class="w-full h-full object-cover">
            <span class="tag-float absolute top-4 left-4 text-[11px] font-semibold px-3 py-1 rounded-full rotate-[-3deg]">🍞 Masa madre</span>
            <span class="tag-float absolute bottom-5 right-4 text-[11px] font-semibold px-3 py-1 rounded-full rotate-[2deg]">👨‍🍳 Recomienda el chef</span>
          </div>
          <div>
            <div class="flex items-start gap-4 mb-3">
              <span class="font-display text-4xl text-guinda/30 font-bold">01</span>
              <div>
                <h3 class="font-display text-2xl sm:text-3xl font-semibold text-cacao">Desayuno Vittorio</h3>
                <span class="font-display text-xl text-guinda font-bold">$7.990</span>
              </div>
            </div>
            <p class="text-cacao/60 leading-relaxed mb-4 max-w-md">Nuestro plato insignia: la mesa completa para partir bien el día, servida sobre pan de masa madre horneado esa misma mañana.</p>
            <ul class="text-sm text-cacao/70 space-y-1.5 border-t border-blush/70 pt-4 max-w-xs">
              <li>· Pan de masa madre artesanal</li>
              <li>· Huevos a elección</li>
              <li>· Palta Hass y jamón serrano</li>
              <li>· Queso fresco de campo</li>
              <li>· Café o té de la casa</li>
            </ul>
          </div>
        </article>

        <!-- Dish 02 — feature, reversed -->
        <article data-id="d2" class="dish grid sm:grid-cols-[1.1fr_0.9fr] gap-8 items-center">
          <div class="sm:order-2 relative blob-b overflow-hidden aspect-[4/5] shadow-xl shadow-guinda/10">
            <img src="https://images.unsplash.com/photo-1541519227354-08fa5d50c44d?q=80&w=800&auto=format&fit=crop" alt="Tostada de masa madre con palta y huevo pochado" class="w-full h-full object-cover">
            <span class="tag-float absolute top-5 right-5 text-[11px] font-semibold px-3 py-1 rounded-full rotate-[3deg]">🥑 Veggie</span>
          </div>
          <div class="sm:order-1">
            <div class="flex items-start gap-4 mb-3">
              <span class="font-display text-4xl text-guinda/30 font-bold">02</span>
              <div>
                <h3 class="font-display text-2xl sm:text-3xl font-semibold text-cacao">Tostadas Palta Pochet</h3>
                <span class="font-display text-xl text-guinda font-bold">$6.500</span>
              </div>
            </div>
            <p class="text-cacao/60 leading-relaxed mb-4 max-w-md">Ligera, fresca y siempre pedida dos veces. El huevo pochado se rompe justo cuando el pan aún está tibio.</p>
            <ul class="text-sm text-cacao/70 space-y-1.5 border-t border-blush/70 pt-4 max-w-xs">
              <li>· Masa madre tostada</li>
              <li>· Palta machacada al limón</li>
              <li>· Huevo pochado</li>
              <li>· Semillas tostadas</li>
            </ul>
          </div>
        </article>

        <!-- Beverage list — editorial, no photos -->
        <div data-id="dbev" class="dish">
          <p class="font-display italic text-guinda text-sm mb-5">— Para beber esta mañana —</p>
          <div class="divide-y divide-blush/70 border-y border-blush/70 max-w-2xl">
            <div class="flex items-center justify-between py-4">
              <div class="flex items-baseline gap-4">
                <span class="font-display text-2xl text-guinda/30 font-bold w-8">03</span>
                <div>
                  <h4 class="font-display text-lg font-semibold text-cacao">Cafecito Vitto Latte</h4>
                  <p class="text-cacao/50 text-xs mt-0.5">Espresso de especialidad, leche vaporizada, arte latte</p>
                </div>
              </div>
              <span class="font-display font-bold text-guinda whitespace-nowrap">$3.500</span>
            </div>
            <div class="flex items-center justify-between py-4">
              <div class="flex items-baseline gap-4">
                <span class="font-display text-2xl text-guinda/30 font-bold w-8">04</span>
                <div>
                  <h4 class="font-display text-lg font-semibold text-cacao">Flat White</h4>
                  <p class="text-cacao/50 text-xs mt-0.5">Doble espresso, textura sedosa, cuerpo intenso</p>
                </div>
              </div>
              <span class="font-display font-bold text-guinda whitespace-nowrap">$3.800</span>
            </div>
            <div class="flex items-center justify-between py-4">
              <div class="flex items-baseline gap-4">
                <span class="font-display text-2xl text-guinda/30 font-bold w-8">05</span>
                <div>
                  <h4 class="font-display text-lg font-semibold text-cacao">Chai Latte</h4>
                  <p class="text-cacao/50 text-xs mt-0.5">Especiado, con canela, miel y leche vaporizada</p>
                </div>
              </div>
              <span class="font-display font-bold text-guinda whitespace-nowrap">$4.500</span>
            </div>
          </div>
        </div>

        <!-- ======= Acordeón — Carta Completa Capítulo I ======= -->
        <div class="accordion-block max-w-2xl">
          <button class="accordion-toggle w-full flex items-center justify-between gap-4 border border-guinda/30 rounded-full px-6 py-4 bg-white/70 hover:bg-white transition-colors">
            <span class="font-display italic text-guinda text-base sm:text-lg transition-colors">Ver Carta Completa de Cafetería y Desayunos</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-guinda shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div class="accordion-panel">
            <div class="accordion-inner pt-6 pb-2">

              <div class="flex items-start justify-between gap-4 py-3 border-b border-blush/60">
                <div>
                  <h5 class="font-display text-base font-semibold text-cacao">Espresso</h5>
                  <p class="text-cacao/50 text-xs mt-1 max-w-md">Extracción intensa y aromática, base de nuestra carta de café.</p>
                </div>
                <span class="font-display font-bold text-guinda whitespace-nowrap">$2.200</span>
              </div>

              <div class="flex items-start justify-between gap-4 py-3 border-b border-blush/60">
                <div>
                  <h5 class="font-display text-base font-semibold text-cacao">Double Espresso</h5>
                  <p class="text-cacao/50 text-xs mt-1 max-w-md">Doble shot para los días que piden un poco más.</p>
                </div>
                <span class="font-display font-bold text-guinda whitespace-nowrap">$2.600</span>
              </div>

              <div class="flex items-start justify-between gap-4 py-3 border-b border-blush/60">
                <div>
                  <h5 class="font-display text-base font-semibold text-cacao">Americano</h5>
                  <p class="text-cacao/50 text-xs mt-1 max-w-md">Espresso alargado con agua caliente, suave y limpio.</p>
                </div>
                <span class="font-display font-bold text-guinda whitespace-nowrap">$2.500</span>
              </div>

              <div class="flex items-start justify-between gap-4 py-3 border-b border-blush/60">
                <div>
                  <h5 class="font-display text-base font-semibold text-cacao">Cappuccino</h5>
                  <p class="text-cacao/50 text-xs mt-1 max-w-md">Espresso, leche vaporizada y espuma aterciopelada.</p>
                </div>
                <span class="font-display font-bold text-guinda whitespace-nowrap">$3.200</span>
              </div>

              <div class="flex items-start justify-between gap-4 py-3 border-b border-blush/60">
                <div>
                  <h5 class="font-display text-base font-semibold text-cacao">Mocaccino</h5>
                  <p class="text-cacao/50 text-xs mt-1 max-w-md">Espresso, chocolate y leche vaporizada.</p>
                </div>
                <span class="font-display font-bold text-guinda whitespace-nowrap">$3.800</span>
              </div>

              <div class="flex items-start justify-between gap-4 py-3 border-b border-blush/60">
                <div>
                  <div class="flex items-center gap-2 flex-wrap">
                    <h5 class="font-display text-base font-semibold text-cacao">Iced Matcha Latte</h5>
