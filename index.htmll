    <span class="w-12 h-12 flex items-center justify-center shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M20.5 3.5A10.9 10.9 0 0 0 12 0C5.7 0 .7 5 .7 11.3c0 2 .5 3.9 1.5 5.6L0 24l7.3-1.9a10.9 10.9 0 0 0 4.7 1.1h0c6.3 0 11.4-5 11.4-11.3 0-3-1.2-5.9-3.4-8.1zM12 21.2c-1.5 0-2.9-.4-4.2-1.1l-.3-.2-4.3 1.1 1.1-4.2-.2-.3a9.3 9.3 0 0 1-1.4-5c0-5.2 4.2-9.4 9.4-9.4 2.5 0 4.9 1 6.6 2.8a9.3 9.3 0 0 1 2.7 6.6c0 5.2-4.3 9.4-9.4 9.4zm5.1-6.9c-.3-.1-1.7-.8-1.9-.9-.3-.1-.4-.1-.6.1-.2.3-.7.9-.8 1-.2.2-.3.2-.5.1-.3-.1-1.2-.4-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.4.1-.6l.4-.5c.1-.1.2-.3.2-.4.1-.2 0-.3 0-.4-.1-.1-.6-1.5-.8-2-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 2s.8 2.3 1 2.5c.1.2 1.7 2.6 4.1 3.6.6.2 1 .4 1.4.5.6.2 1.1.2 1.5.1.5-.1 1.7-.7 1.9-1.3.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3z"/></svg>
