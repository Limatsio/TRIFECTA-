<script>
  // ---------- Live open/closed status (America/Santiago) ----------
  function updateStatus(){
    const now = new Date(new Date().toLocaleString('en-US', { timeZone: 'America/Santiago' }));
    const day = now.getDay(); // 0 Sun ... 6 Sat
    const hours = now.getHours() + now.getMinutes() / 60;
    const openTime = (day === 0 || day === 6) ? 9.5 : 8.5;
    const closeTime = 20;
    const isOpen = hours >= openTime && hours < closeTime;

    const dot = document.getElementById('statusDot');
    const text = document.getElementById('statusText');

    const fmt = (h) => {
      const hh = Math.floor(h);
      const mm = Math.round((h - hh) * 60);
      return hh.toString().padStart(2,'0') + ':' + mm.toString().padStart(2,'0');
    };

    if (isOpen) {
      dot.className = 'w-2.5 h-2.5 rounded-full bg-emerald-500 shadow-[0_0_0_4px_rgba(16,185,129,0.18)]';
      text.textContent = 'Abierto ahora · cierra a las ' + fmt(closeTime);
    } else {
      dot.className = 'w-2.5 h-2.5 rounded-full bg-cacao/40 shadow-[0_0_0_4px_rgba(58,42,40,0.12)]';
      const nextOpen = (day === 5 || day === 6) ? 9.5 : 8.5; // heuristic for next day type
      text.textContent = 'Cerrado ahora · abre a las ' + fmt(nextOpen);
    }
  }
  updateStatus();
  setInterval(updateStatus, 60000);

  // ---------- Chapter selector (left panel) ----------
  const chapterTitles = {
    1: 'La Mañana & La Masa Madre',
    2: 'Almuerzos de Autor & Casa',
    3: 'Tardes Dulces & Repostería'
  };
  const ambienceButtons = document.querySelectorAll('.ambience-btn');
  const chapterCaption = document.getElementById('chapterCaption');
  const bodyEl = document.body;

  function setActiveChapter(ch, scroll){
    bodyEl.setAttribute('data-chapter', ch);
    ambienceButtons.forEach(btn => btn.classList.toggle('active', btn.dataset.chapter === String(ch)));
    chapterCaption.textContent = chapterTitles[ch];
    if (scroll) {
      const target = document.getElementById('chapter-' + ch);
      if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  document.getElementById('ambienceSelector').addEventListener('click', (e) => {
    const btn = e.target.closest('button');
    if (!btn) return;
    setActiveChapter(btn.dataset.chapter, true);
  });

  // ---------- Scroll-linked chapter detection (tints left panel) ----------
  const chapterSections = document.querySelectorAll('[data-chapter-section]');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        setActiveChapter(entry.target.dataset.chapterSection, false);
      }
    });
  }, { threshold: 0.35, rootMargin: '-15% 0px -55% 0px' });
  chapterSections.forEach(sec => observer.observe(sec));

  // ---------- Dish hover focus (dim siblings) ----------
  document.querySelectorAll('.chapter-dishes').forEach(container => {
    const dishes = container.querySelectorAll('.dish');
    dishes.forEach(dish => {
      dish.addEventListener('mouseenter', () => {
        dishes.forEach(d => { if (d !== dish) d.classList.add('dimmed'); });
      });
      dish.addEventListener('mouseleave', () => {
        dishes.forEach(d => d.classList.remove('dimmed'));
      });
    });
  });

  // ---------- Fade-up reveal on scroll ----------
  document.querySelectorAll('.dish, blockquote').forEach(el => el.classList.add('fade-up'));
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('in');
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });
  document.querySelectorAll('.fade-up').forEach(el => revealObserver.observe(el));

  // ---------- Accordion: Ver Carta Completa ----------
  document.querySelectorAll('.accordion-toggle').forEach(btn => {
    const panel = btn.nextElementSibling;
    btn.addEventListener('click', () => {
      const isOpen = btn.classList.contains('open');
      if (isOpen) {
        panel.style.maxHeight = '0px';
        btn.classList.remove('open');
      } else {
        panel.style.maxHeight = panel.scrollHeight + 'px';
        btn.classList.add('open');
      }
    });
  });

  // Keep open accordion panels correctly sized if content reflows (e.g. font load, resize)
  window.addEventListener('resize', () => {
    document.querySelectorAll('.accordion-toggle.open').forEach(btn => {
      btn.nextElementSibling.style.maxHeight = btn.nextElementSibling.scrollHeight + 'px';
    });
  });
</script>

</body>
</html>
